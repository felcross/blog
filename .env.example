# ===== Desenvolvimento local (docker-compose.dev.yml + pnpm dev) =====
# API
DATABASE_URL=postgresql://blog:blog@localhost:5433/blog
ADMIN_EMAIL=admin@example.com
PORT=3001
WEB_URL=http://localhost:5173
NODE_ENV=development

# SMTP (Mailpit in development)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM="Blog <noreply@blog.local>"

# SMTP real (Gmail app password) — produção
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Blog <noreply@felbatista.tech>"

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Logging (fatal|error|warn|info|debug|trace|silent)
LOG_LEVEL=info

# Redis / email queue (Phase 4)
# dev: redis://localhost:6379  |  prod (compose): redis://redis:6379
REDIS_URL=redis://localhost:6379
EMAIL_WORKER_CONCURRENCY=5
EMAIL_BACKOFF_MS=5000

# ===== Produção (VPS — descomente/ajuste no .env do servidor) =====
# DATABASE_URL=postgresql://blog:blog@postgres:5432/blog
# ADMIN_EMAIL=seu-email@exemplo.com
# PORT=3001
# WEB_URL=https://blog.felbatista.tech
# NODE_ENV=production
#
# SMTP: usar bloco "SMTP real" acima (preencher SMTP_USER/SMTP_PASS)
#
# Gerar SESSION_SECRET forte: openssl rand -hex 32
# SESSION_SECRET=
#
# Rede externa do Nginx Proxy Manager (docker network ls)
NPM_NETWORK=
#
# Proxies na frente da API (NPM + nginx do web) — p/ rate-limit e Secure cookies
# TRUST_PROXY=2
#
# Credenciais do Postgres (obrigatório em produção)
# POSTGRES_USER=blog
# POSTGRES_PASSWORD=
# POSTGRES_DB=blog
